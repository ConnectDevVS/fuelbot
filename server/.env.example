# Copy to server/.env (gitignored). Every value has a dev default; see src/settings.js.

# HTTP
PORT=8790
HOST=127.0.0.1
# Base URL this server is reached at (used for local-storage image URLs).
PUBLIC_URL=http://127.0.0.1:8790

# MongoDB (npm run db starts a local one on 27017)
MONGO_URL=mongodb://127.0.0.1:27017/fuelbot

# Dashboard sessions. REQUIRED in production (NODE_ENV=production): a long random string.
# JWT_SECRET=
SESSION_HOURS=12
# COOKIE_SECURE=true   (default: true in production)
LOGIN_RATE_LIMIT=10

# Machine auth: off | optional (wrong key refused, missing allowed) | required
MACHINE_AUTH=optional
# A machine not seen for this long shows as offline (the app polls config every 120 s).
OFFLINE_AFTER_SEC=300
# Days in reports are grouped in this time zone.
DISPLAY_TZ=Asia/Kolkata

# Flavor images: local (served at /files/, dev only) | s3
STORAGE=local
# LOCAL_STORAGE_DIR=./uploads
# S3_BUCKET=fuelbot-assets
# S3_REGION=ap-south-1
# S3_PREFIX=
# S3_PUBLIC_BASE_URL=https://fuelbot-assets.s3.ap-south-1.amazonaws.com
# AWS credentials: the standard AWS SDK chain (AWS_PROFILE, AWS_ACCESS_KEY_ID/…, instance role).

LOG_REQUESTS=true
